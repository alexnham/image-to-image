# Auth.js: generate with `npx auth secret`
AUTH_SECRET=
# Only needed for `next start` outside Vercel
# AUTH_TRUST_HOST=true
# Google OAuth client (Google Cloud console → APIs & Services → Credentials)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Set by the Vercel Neon integration
DATABASE_URL=
# Set by the Vercel Blob store (choose private access)
BLOB_READ_WRITE_TOKEN=
# Server-only OpenAI API key. Paid calls use the global cap below.
OPENAI_API_KEY=
# Hard app-side monthly budget in USD; 0 pauses paid actions. Default 10.
MONTHLY_API_CAP_USD=10
# Optional capacity notification (Resend verified sender)
RESEND_API_KEY=
OPERATOR_EMAIL=
ALERT_FROM_EMAIL=
# Development-only local preview account; never enabled in production
LOCAL_DEV_AUTH=false
